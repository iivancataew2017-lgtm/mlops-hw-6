<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Replacement" targetNamespace="https://github.com/iivancataew2017-lgtm/mlops-dz-6" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:error id="Error_ML" name="Ошибка, тайм-аут или невалидный ответ ML" errorCode="ML_UNAVAILABLE" />
  <bpmn:error id="Error_Catalog" name="Нет актуального меню" errorCode="MENU_UNAVAILABLE" />
  <bpmn:process id="Process_Replacement" name="Подбор замены недоступного блюда" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_ML" name="ML-сервис">
        <bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ML_Error</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Select" name="Сервис замены товара">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B8a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B8b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B8c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OptionsSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catalog_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_Timeout</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>F_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartMessage" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="B2" name="Получить&#10;корзину и меню">
      <bpmn:incoming>F_Start</bpmn:incoming>
      <bpmn:outgoing>F_ToML</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B3" name="Оценить&#10;кандидатов">
      <bpmn:incoming>F_ToML</bpmn:incoming>
      <bpmn:outgoing>F_MLResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B4" name="Оценка&#10;по tolerance" default="F_NoML">
      <bpmn:incoming>F_MLResult</bpmn:incoming>
      <bpmn:outgoing>F_YesML</bpmn:outgoing>
      <bpmn:outgoing>F_NoML</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B5" name="Подобрать&#10;по правилу">
      <bpmn:incoming>F_NoML</bpmn:incoming>
      <bpmn:incoming>F_Error</bpmn:incoming>
      <bpmn:outgoing>F_Rule</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B6" name="Проверить&#10;доступность">
      <bpmn:incoming>F_YesML</bpmn:incoming>
      <bpmn:incoming>F_Rule</bpmn:incoming>
      <bpmn:outgoing>F_Availability</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="B7" name="Есть&#10;варианты?" default="F_Empty">
      <bpmn:incoming>F_Availability</bpmn:incoming>
      <bpmn:outgoing>F_Show</bpmn:outgoing>
      <bpmn:outgoing>F_Empty</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="B8a" name="Показать&#10;до 3 блюд">
      <bpmn:incoming>F_Show</bpmn:incoming>
      <bpmn:outgoing>F_Wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="B8b" name="Завершить&#10;без замены">
      <bpmn:incoming>F_CatalogFail</bpmn:incoming>
      <bpmn:incoming>F_Empty</bpmn:incoming>
      <bpmn:outgoing>F_NoOptions</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="B8c" name="Получить&#10;решение">
      <bpmn:incoming>F_Wait</bpmn:incoming>
      <bpmn:outgoing>F_Choice</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Choice" name="Блюдо&#10;выбрано?" default="F_Refused">
      <bpmn:incoming>F_Choice</bpmn:incoming>
      <bpmn:outgoing>F_Apply</bpmn:outgoing>
      <bpmn:outgoing>F_Refused</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B9" name="Применить&#10;замену">
      <bpmn:incoming>F_Apply</bpmn:incoming>
      <bpmn:outgoing>F_Applied</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="MergeOutcome" name="" gatewayDirection="Converging">
      <bpmn:incoming>F_NoOptions</bpmn:incoming>
      <bpmn:incoming>F_Refused</bpmn:incoming>
      <bpmn:incoming>F_UserTimeout</bpmn:incoming>
      <bpmn:incoming>F_Applied</bpmn:incoming>
      <bpmn:outgoing>F_Log</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B10" name="Записать&#10;показ и исход">
      <bpmn:incoming>F_Log</bpmn:incoming>
      <bpmn:outgoing>F_CheckOptions</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OptionsSent" name="Был&#10;показ?" default="F_Silent">
      <bpmn:incoming>F_CheckOptions</bpmn:incoming>
      <bpmn:outgoing>F_Return</bpmn:outgoing>
      <bpmn:outgoing>F_Silent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="B11" name="Вернуть&#10;итог">
      <bpmn:incoming>F_Return</bpmn:incoming>
      <bpmn:outgoing>F_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End" name="Подбор завершён">
      <bpmn:incoming>F_End</bpmn:incoming>
      <bpmn:incoming>F_Silent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Catalog_Error" name="Ошибка меню" attachedToRef="B2">
      <bpmn:outgoing>F_CatalogFail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Catalog_ErrorDef" errorRef="Error_Catalog" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="User_Timeout" name="Нет ответа" attachedToRef="B8c">
      <bpmn:outgoing>F_UserTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="User_TimeoutDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${confirmationTimeout}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="ML_Error" name="Сбой ML" attachedToRef="B3">
      <bpmn:outgoing>F_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ML_ErrorDef" errorRef="Error_ML" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_Start" sourceRef="Start" targetRef="B2" />
    <bpmn:sequenceFlow id="F_ToML" sourceRef="B2" targetRef="B3" />
    <bpmn:sequenceFlow id="F_MLResult" sourceRef="B3" targetRef="B4" />
    <bpmn:sequenceFlow id="F_YesML" name="Да" sourceRef="B4" targetRef="B6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid_response and max_p_accept &gt;= tolerance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NoML" name="Нет" sourceRef="B4" targetRef="B5" />
    <bpmn:sequenceFlow id="F_Error" sourceRef="ML_Error" targetRef="B5" />
    <bpmn:sequenceFlow id="F_Rule" sourceRef="B5" targetRef="B6" />
    <bpmn:sequenceFlow id="F_Availability" sourceRef="B6" targetRef="B7" />
    <bpmn:sequenceFlow id="F_Show" name="Да" sourceRef="B7" targetRef="B8a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">len(candidates) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Empty" name="Нет" sourceRef="B7" targetRef="B8b" />
    <bpmn:sequenceFlow id="F_Wait" sourceRef="B8a" targetRef="B8c" />
    <bpmn:sequenceFlow id="F_CatalogFail" sourceRef="Catalog_Error" targetRef="B8b" />
    <bpmn:sequenceFlow id="F_NoOptions" sourceRef="B8b" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="F_Choice" sourceRef="B8c" targetRef="Choice" />
    <bpmn:sequenceFlow id="F_Apply" name="Да" sourceRef="Choice" targetRef="B9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_item_id is not None</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Refused" name="Отказ" sourceRef="Choice" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="F_Applied" sourceRef="B9" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="F_UserTimeout" sourceRef="User_Timeout" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="F_Log" sourceRef="MergeOutcome" targetRef="B10" />
    <bpmn:sequenceFlow id="F_CheckOptions" sourceRef="B10" targetRef="OptionsSent" />
    <bpmn:sequenceFlow id="F_Return" name="Да" sourceRef="OptionsSent" targetRef="B11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">options_sent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Silent" name="Нет" sourceRef="OptionsSent" targetRef="End" />
    <bpmn:sequenceFlow id="F_End" sourceRef="B11" targetRef="End" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Replacement" name="Подбор замены блюда в корзине Яндекс Еды">
    <bpmn:participant id="Pool_Buyer" name="Покупатель" />
    <bpmn:participant id="Pool_System" name="Система подбора товара" processRef="Process_Replacement" />
    <bpmn:participant id="Pool_Training" name="ML-пайплайн" />
    <bpmn:messageFlow id="M_Request" name="Запрос замены" sourceRef="Pool_Buyer" targetRef="Start" />
    <bpmn:messageFlow id="M_Options" name="Варианты" sourceRef="B8a" targetRef="Pool_Buyer" />
    <bpmn:messageFlow id="M_Choice" name="Выбор или отказ" sourceRef="Pool_Buyer" targetRef="B8c" />
    <bpmn:messageFlow id="M_Result" name="Итог подбора" sourceRef="B11" targetRef="Pool_Buyer" />
    <bpmn:messageFlow id="M_Feedback" name="Показ и исход" sourceRef="B10" targetRef="Pool_Training" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Replacement" name="BPMN — замена недоступного блюда в корзине Яндекс Еды">
